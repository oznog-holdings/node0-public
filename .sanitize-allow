# Accepted exceptions for tools/sanitize-check.py, one per line:
#   rule=<rule> <literal-or-re:regex> # reason of at least three words
# A literal must equal the whole token the gate matched; a regex must match the whole
# token. There are no exceptions for images: strip the metadata. Empty as of 20260922.
rule=credential-store-name Bitwarden # the seed's hosted password manager, named on the seed pages by Christoph's rule that the seed names its parts (20260928)
rule=credential-store-name re:(?i)(https?://)?(www\.)?bitwarden\.com/? # the link to Bitwarden's home page in the seed's projects table (20260928)
rule=ipv4-literal re:192\.168\.(?:1|20|30)\.0 # the Seed's own LAN, guest and IoT networks in the rung 6 table (publication policy, 20260928)
